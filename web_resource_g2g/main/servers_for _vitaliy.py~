import re

def sort_and_reorder(data):
    lines = data.strip().split('\n')
    sorted_lines = sorted(lines, key=lambda line: re.split(r'\s{2,}', line)[0]) #сортування за назвою сервера

    result = []
    for line in sorted_lines:
        parts = re.split(r'\s{2,}', line)
        if len(parts) == 2:
            server_name, user_name = parts
            result.append(f"{server_name} {user_name}")
    return '\n'.join(result)

